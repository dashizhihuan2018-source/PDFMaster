{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF Master Rust Candidate",
  "version": "2.0.0",
  "identifier": "top.maip.pdfmaster.rust-candidate",
  "build": {
    "beforeDevCommand": "trunk --no-color serve",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bash tools/prepare-tauri-build.sh",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{"label":"main","title":"PDF Master · Rust 迁移候选","width":1280,"height":840,"minWidth":360,"minHeight":540}],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Productivity",
    "shortDescription": "Rust PDF workspace — migration candidate, not full-parity release",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../target/third-party-notices/macos-aarch64.html": "third-party-notices/macos-aarch64.html",
      "../target/third-party-notices/windows-x86_64.html": "third-party-notices/windows-x86_64.html",
      "../target/third-party-notices/ios-simulator-aarch64.html": "third-party-notices/ios-simulator-aarch64.html",
      "../target/third-party-notices/ios-device-aarch64.html": "third-party-notices/ios-device-aarch64.html",
      "../target/third-party-notices/ui-wasm32.html": "third-party-notices/ui-wasm32.html"
    },
    "macOS": {"minimumSystemVersion":"14.0","signingIdentity":"-"},
    "iOS": {"minimumSystemVersion":"16.0"}
  }
}
